[Unit]
Description=DJUA SMS Gateway Service (Production Daemon)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__
SupplementaryGroups=dialout
ExecStart=__PYTHON_BIN__ scripts/run_gateway.py --config config/gateway.env
Environment=PYTHONPATH=__ROOT__/src:__ROOT__
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
