[Unit]
Description=DJUA SMS Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__
SupplementaryGroups=dialout
ExecStart=__ROOT__/.venv/bin/python scripts/run_gateway.py --config config/gateway.env
Environment=PYTHONPATH=__ROOT__/src:__ROOT__
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
