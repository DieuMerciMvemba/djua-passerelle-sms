# Configuration DJUA_SMS Gateway
DATABASE_PATH=data/djua_sms_gateway.db
GATEWAY_LOG_PATH=logs/gateway.log
GATEWAY_LOG_LEVEL=INFO
GATEWAY_STOP_FILE=data/gateway.stop
GATEWAY_PLATFORM=windows

# Modem SIM868 Récepteur (Port série)
SERIAL_PORT=COM16
SERIAL_BAUD_RATE=9600
SERIAL_TIMEOUT_SECONDS=0.5
SERIAL_WRITE_TIMEOUT_SECONDS=2
GSM_INIT_RETRIES=3
GSM_COMMAND_TIMEOUT_SECONDS=5
GSM_RECONNECT_SECONDS=5
GSM_SMS_STORAGE=SM
GSM_CNMI=2,1,0,0,0

# Mode de sécurité D2 (development accepte AUTH=-)
D2_AUTH_MODE=development
D2_HMAC_KEYS_JSON={"DJUA-KIN-000001": "ebe401b50ae09171a9fbc37231f79224efa195926ab90dc6dcc5e93a44f21f27", "DJUA-TEST-20261006-A": "242e95312094dceec17b4c4b7263a9e4505d5bcd7becda7d9411a3589ac48d48"}
D2_SENDER_BINDINGS_JSON={}

# Transport Backend sélectionné (http, mqtt ou both)
BACKEND_TRANSPORT=http

# Configuration HTTP REST Backend
HTTP_BACKEND_URL=https://djua-energy-backend.onrender.com/api/iot/telemetry
HTTP_EVENTS_URL=https://djua-energy-backend.onrender.com/api/iot/alerts
HTTP_AUTH_TOKEN=
HTTP_EXTRA_HEADERS_JSON={"x-device-token": "djua"}
HTTP_TIMEOUT_SECONDS=10
HTTP_VERIFY_TLS=true
HTTP_RETRY_BASE_SECONDS=2
HTTP_RETRY_MAX_SECONDS=300
HTTP_BATCH_LIMIT=10

# Configuration MQTT (inactive quand BACKEND_TRANSPORT=http)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=djua-sms-gateway-001
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=djua/test
MQTT_QOS=1
MQTT_RETAIN=false
MQTT_KEEPALIVE_SECONDS=60
MQTT_CONNECT_TIMEOUT_SECONDS=10
MQTT_PUBLISH_TIMEOUT_SECONDS=10
MQTT_RETRY_BASE_SECONDS=2
MQTT_RETRY_MAX_SECONDS=300
MQTT_TLS=false
