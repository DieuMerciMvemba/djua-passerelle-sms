# Configuration DJUA_SMS Gateway - LOCAL (Labo LAN / Dev)
DATABASE_PATH=data/djua_sms_gateway.db
GATEWAY_LOG_PATH=logs/gateway.log
GATEWAY_LOG_LEVEL=INFO
GATEWAY_STOP_FILE=data/gateway.stop
GATEWAY_PLATFORM=linux

# Modem SIM868 Récepteur (Port série USB CP2102)
SERIAL_PORT=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0
SERIAL_BAUD_RATE=9600
SERIAL_TIMEOUT_SECONDS=0.5
SERIAL_WRITE_TIMEOUT_SECONDS=2
GSM_INIT_RETRIES=3
GSM_COMMAND_TIMEOUT_SECONDS=5
GSM_RECONNECT_SECONDS=5
GSM_SMS_STORAGE=SM
GSM_CNMI=2,1,0,0,0

# Mode de sécurité D2 (development accepte AUTH=- ; production exige HMAC valide)
D2_AUTH_MODE=development
D2_HMAC_KEYS_JSON={}
D2_SENDER_BINDINGS_JSON={}

# Transport Backend sélectionné (http, mqtt ou both)
BACKEND_TRANSPORT=http

# ==============================================================================
# Configuration HTTP REST Backend : LOCAL / LABO LAN
# Route dynamique avec device_id : /api/iot/{device_id}/telemetry
# ==============================================================================
HTTP_BACKEND_URL=http://10.252.252.52:5000/api/iot/{device_id}/telemetry
HTTP_EVENTS_URL=http://10.252.252.52:5000/api/iot/{device_id}/alerts
HTTP_AUTH_TOKEN=
IOT_API_KEY=djua
HTTP_EXTRA_HEADERS_JSON={"x-device-token": "djua"}
HTTP_TIMEOUT_SECONDS=5
HTTP_VERIFY_TLS=false
HTTP_RETRY_BASE_SECONDS=2
HTTP_RETRY_MAX_SECONDS=300
HTTP_BATCH_LIMIT=10

# Configuration MQTT (inactive quand BACKEND_TRANSPORT=http)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=djua-sms-gateway-001
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=djua/test
MQTT_QOS=1
MQTT_RETAIN=false
MQTT_KEEPALIVE_SECONDS=60
MQTT_CONNECT_TIMEOUT_SECONDS=10
MQTT_PUBLISH_TIMEOUT_SECONDS=10
MQTT_RETRY_BASE_SECONDS=2
MQTT_RETRY_MAX_SECONDS=300
MQTT_TLS=false
