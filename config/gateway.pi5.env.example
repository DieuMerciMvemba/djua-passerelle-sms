# DJUA_SMS Raspberry Pi 5 gateway configuration.
# Copy this file to config/gateway.env, then set MQTT_HOST and any credentials.

DATABASE_PATH=data/djua_sms_gateway.db
GATEWAY_LOG_PATH=logs/gateway.log
GATEWAY_LOG_LEVEL=INFO
GATEWAY_STOP_FILE=data/gateway.stop
GATEWAY_PLATFORM=linux

# Select the SIM868 serial device. Alternatives:
# SERIAL_PORT=/dev/serial/by-id/usb-...
# SERIAL_PORT=/dev/serial0  # UART GPIO pins
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD_RATE=9600
SERIAL_TIMEOUT_SECONDS=0.5
SERIAL_WRITE_TIMEOUT_SECONDS=2
GSM_INIT_RETRIES=3
GSM_COMMAND_TIMEOUT_SECONDS=5
GSM_RECONNECT_SECONDS=5
GSM_SMS_STORAGE=SM
GSM_CNMI=2,1,0,0,0

# Development accepts AUTH=-; use production keys for deployment.
D2_AUTH_MODE=development
D2_HMAC_KEYS_JSON={}
D2_SENDER_BINDINGS_JSON={}

MQTT_HOST=CHANGE_ME
MQTT_PORT=1883
MQTT_CLIENT_ID=djua-sms-gateway-001
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=djua/test
MQTT_QOS=1
MQTT_RETAIN=false
MQTT_KEEPALIVE_SECONDS=60
MQTT_CONNECT_TIMEOUT_SECONDS=10
MQTT_PUBLISH_TIMEOUT_SECONDS=10
MQTT_RETRY_BASE_SECONDS=2
MQTT_RETRY_MAX_SECONDS=300
MQTT_TLS=false
